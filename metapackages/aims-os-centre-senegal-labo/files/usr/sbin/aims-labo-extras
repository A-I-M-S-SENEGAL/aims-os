#!/bin/bash
# =============================================================================
# aims-labo-extras — vendor software for the lab golden machine (run once, root)
# =============================================================================
# Everything here comes from outside Debian: vendor apt repositories (kept
# up to date by apt afterwards) or upstream archives unpacked in /opt.
# Re-runnable: each step skips what is already there.
#
#   aims-labo-extras            everything
#   aims-labo-extras <step>...  only some steps: repos code chrome zotero bruno
#                               drawio julia ghidra android geogebra dbimages zoom rstudio sage webapps
# =============================================================================
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "root required" >&2; exit 1; }
export DEBIAN_FRONTEND=noninteractive
KEYS=/usr/share/keyrings; LIST=/etc/apt/sources.list.d; ARCH=$(dpkg --print-architecture)
# IPv4 only: the campus has no IPv6 connectivity (see sysctl.d/60-aims-labo-ipv6.conf)
# Retries: the campus link drops a connection now and then (1 in 6 measured
# on 2026-09-07 from both a lab machine and the server).
curl() { command curl -4 --retry 6 --retry-delay 5 --retry-all-errors --connect-timeout 20 "$@"; }
export JAVA_TOOL_OPTIONS="-Djava.net.preferIPv4Stack=true"
log() { printf '\033[1;34m[aims-labo-extras]\033[0m %s\n' "$*"; }
need() { command -v "$1" >/dev/null 2>&1 || apt-get -q -y install "$1" >/dev/null; }
desktop_entry() { # name exec icon comment
    cat > "/usr/share/applications/$1.desktop" <<D
[Desktop Entry]
Type=Application
Name=$2
Exec=$3
Icon=$4
Comment=$5
Categories=Development;
Terminal=false
D
}

step_repos() {
    need curl; need gpg
    # keyring helper: always re-fetch (a truncated download once left an
    # unusable key behind) and refuse to keep a file gpg cannot read.
    fetch_key() { # url dest
        local tmp; tmp=$(mktemp)
        curl -fsSL "$1" -o "$tmp" && gpg --dearmor --yes -o "$2" "$tmp" && gpg --show-keys "$2" >/dev/null 2>&1 \
            || { rm -f "$2"; echo "key fetch failed: $1" >&2; rm -f "$tmp"; return 1; }
        rm -f "$tmp"; chmod 0644 "$2"
    }
    log "Microsoft (VS Code)"
    fetch_key https://packages.microsoft.com/keys/microsoft.asc $KEYS/microsoft.gpg
    echo "deb [arch=amd64,arm64 signed-by=$KEYS/microsoft.gpg] https://packages.microsoft.com/repos/code stable main" > $LIST/vscode.list
    log "Google (Chrome)"
    # Chrome's own package installs /etc/apt/sources.list.d/google-chrome.sources; ours only bootstraps
    if [ ! -f $LIST/google-chrome.sources ]; then
        fetch_key https://dl.google.com/linux/linux_signing_key.pub $KEYS/google-chrome.gpg
        echo "deb [arch=amd64 signed-by=$KEYS/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" > $LIST/google-chrome.list
    else
        rm -f $LIST/google-chrome.list
    fi
    log "Bruno"
    fetch_key "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x9FA6017ECABE0266" $KEYS/bruno.gpg
    echo "deb [signed-by=$KEYS/bruno.gpg] http://debian.usebruno.com/ bruno stable" > $LIST/bruno.list
    apt-get -q update 2>&1 | grep -E "^(E|W):" || true
}
step_code()   { log "VS Code";  apt-get -q -y install code >/dev/null; }
step_chrome() { log "Google Chrome"; apt-get -q -y install google-chrome-stable >/dev/null; }
step_bruno()  { log "Bruno (API client)"; apt-get -q -y install bruno >/dev/null; }
step_zotero() {
    log "Zotero (retorquere apt repo)"
    need curl
    if [ ! -f $LIST/zotero.list ] && [ ! -f $LIST/zotero.sources ]; then
        curl -fsSL https://raw.githubusercontent.com/retorquere/zotero-deb/master/install.sh | bash >/dev/null
        apt-get -q update >/dev/null
    fi
    apt-get -q -y install zotero >/dev/null
}
step_drawio() {
    log "draw.io desktop"
    need curl
    # No GitHub API (rate-limited per campus IP): follow the "latest" redirect to the tag.
    tag=$(curl -s -o /dev/null -w '%{redirect_url}' https://github.com/jgraph/drawio-desktop/releases/latest | grep -oE 'v[0-9.]+$')
    [ -n "$tag" ] || { echo "draw.io: latest tag not found" >&2; return 1; }
    url="https://github.com/jgraph/drawio-desktop/releases/download/${tag}/drawio-amd64-${tag#v}.deb"
    dpkg -l drawio >/dev/null 2>&1 && dpkg -l drawio | grep -q "^ii.*$(echo "$url" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')" && return 0
    curl -fsSL -o /tmp/drawio.deb "$url" && apt-get -q -y install /tmp/drawio.deb 2>&1 | grep -E "^(E:|Setting up drawio)" ; rm -f /tmp/drawio.deb
    dpkg -s drawio >/dev/null 2>&1
}
step_julia() {
    log "Julia (official binaries, /opt/julia)"
    need curl; need python3
    read -r ver url sha < <(curl -fsSL https://julialang-s3.julialang.org/bin/versions.json | python3 -c '
import json,sys
d=json.load(sys.stdin)
stable=[v for v,i in d.items() if i.get("stable")]
stable.sort(key=lambda v:[int(x) for x in v.split(".")])
v=stable[-1]
for f in d[v]["files"]:
    if f["os"]=="linux" and f["arch"]=="x86_64" and f["kind"]=="archive": print(v,f["url"],f["sha256"]); break')
    if [ -x /opt/julia/bin/julia ] && /opt/julia/bin/julia --version | grep -q "$ver"; then return 0; fi
    curl -fsSL -o /tmp/julia.tgz "$url"; echo "$sha  /tmp/julia.tgz" | sha256sum -c --quiet
    rm -rf /opt/julia && mkdir -p /opt/julia && tar -xzf /tmp/julia.tgz -C /opt/julia --strip-components=1 && rm -f /tmp/julia.tgz
    ln -sf /opt/julia/bin/julia /usr/local/bin/julia
}
step_ghidra() {
    log "Ghidra (GitHub release, /opt/ghidra)"
    need curl; need unzip; apt-get -q -y install default-jdk >/dev/null
    url=$(curl -fsSL https://api.github.com/repos/NationalSecurityAgency/ghidra/releases/latest | grep -oE 'https://[^"]+ghidra_[0-9.]+_PUBLIC_[0-9]+\.zip' | head -1)
    [ -n "$url" ] || { echo "ghidra: release URL not found" >&2; return 1; }
    ver=$(echo "$url" | grep -oE 'ghidra_[0-9.]+_PUBLIC')
    [ -f "/opt/ghidra/.version" ] && [ "$(cat /opt/ghidra/.version)" = "$ver" ] && return 0
    curl -fsSL -o /tmp/ghidra.zip "$url"; rm -rf /opt/ghidra /tmp/ghidra-x && mkdir -p /tmp/ghidra-x && unzip -q /tmp/ghidra.zip -d /tmp/ghidra-x
    mv /tmp/ghidra-x/ghidra_* /opt/ghidra && echo "$ver" > /opt/ghidra/.version && rm -rf /tmp/ghidra.zip /tmp/ghidra-x
    chmod +x /opt/ghidra/ghidraRun
    desktop_entry ghidra "Ghidra" "/opt/ghidra/ghidraRun" "/opt/ghidra/support/ghidra.ico" "Rétro-ingénierie (NSA)"
}
step_android() {
    log "Android Studio + shared SDK (/opt/android-studio, /opt/android-sdk)"
    need curl; need unzip; apt-get -q -y install default-jdk libc6:i386 2>/dev/null || true
    # The page carries the real Linux archive URL, e.g.
    # https://edgedl.me.gvt1.com/android/studio/ide-zips/2026.1.4.7/android-studio-quail4-linux.tar.gz
    page=$(curl -fsSL https://developer.android.com/studio)
    url=$(echo "$page" | grep -oE 'https://[a-zA-Z0-9./_-]*/ide-zips/[0-9.]+/android-studio-[a-zA-Z0-9._-]+-linux\.tar\.gz' | head -1)
    [ -n "$url" ] || { echo "android studio: Linux archive URL not found on developer.android.com" >&2; return 1; }
    sver=$(echo "$url" | grep -oE 'ide-zips/[0-9.]+' | cut -d/ -f2)
    ver="android-studio-${sver}"
    if [ ! -f /opt/android-studio/.version ] || [ "$(cat /opt/android-studio/.version)" != "$ver" ]; then
        curl -fL -o /tmp/android-studio.tgz "$url"
        rm -rf /opt/android-studio && tar -xzf /tmp/android-studio.tgz -C /opt && echo "$ver" > /opt/android-studio/.version && rm -f /tmp/android-studio.tgz
        desktop_entry android-studio "Android Studio" "/opt/android-studio/bin/studio.sh" "/opt/android-studio/bin/studio.png" "IDE Android (Google)"
    fi
    # shared SDK
    # Command-line tools: newest name listed in Google's repository manifest.
    tname=$(curl -fsSL https://dl.google.com/android/repository/repository2-3.xml | grep -oE 'commandlinetools-linux-[0-9]+_latest\.zip' | sort -t- -k3 -n | tail -1)
    tools="https://dl.google.com/android/repository/${tname}"
    [ -n "$tname" ] || { echo "android sdk: command-line tools name not found" >&2; return 1; }
    mkdir -p /opt/android-sdk/cmdline-tools
    if [ ! -x /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager ]; then
        curl -fL -o /tmp/cmdtools.zip "$tools" && rm -rf /tmp/cmdtools && unzip -q /tmp/cmdtools.zip -d /tmp/cmdtools
        rm -rf /opt/android-sdk/cmdline-tools/latest && mv /tmp/cmdtools/cmdline-tools /opt/android-sdk/cmdline-tools/latest && rm -rf /tmp/cmdtools /tmp/cmdtools.zip
    fi
    export ANDROID_HOME=/opt/android-sdk
    yes | /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager --sdk_root=/opt/android-sdk --licenses >/dev/null 2>&1 || true
    /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager --sdk_root=/opt/android-sdk \
        "platform-tools" "platforms;android-35" "build-tools;35.0.0" "emulator" \
        "system-images;android-35;google_apis;x86_64" >/dev/null
    chmod -R a+rX /opt/android-sdk
    # Studio must not try to write the shared SDK; students keep AVDs/caches in their home
    install -d -m 0755 /etc/skel/.config/Google 2>/dev/null || true
}
step_geogebra() {
    log "GeoGebra (Flatpak, system-wide)"
    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
    flatpak install -y --noninteractive --system flathub org.geogebra.GeoGebra >/dev/null
}
step_zoom() {
    log "Zoom (deb from zoom.us)"
    curl -fsSL -o /tmp/zoom.deb https://zoom.us/client/latest/zoom_amd64.deb
    apt-get -q -y install /tmp/zoom.deb 2>&1 | grep -E "^(E:|Setting up zoom)"; rm -f /tmp/zoom.deb
    dpkg -s zoom >/dev/null 2>&1
}
step_rstudio() {
    log "RStudio (AIMS OS install script, Posit deb)"
    local rs; rs=$(ls /usr/share/aims-os/install/rstudio.sh /usr/share/aims-os/install/install/rstudio.sh 2>/dev/null | head -1)
    [ -n "$rs" ] || { echo "rstudio.sh missing (aims-os-welcome)" >&2; return 1; }
    "$rs" >/dev/null 2>&1 || "$rs"
    dpkg -s rstudio >/dev/null 2>&1
}
step_sage() {
    # SageMath is not installable from Debian 13 (Python 3.13 mismatch);
    # conda-forge ships it. One shared environment under /opt/sage.
    log "SageMath (conda-forge, /opt/sage, ~4 GB)"
    local mf; mf=$(ls -d /opt/miniforge* /opt/conda 2>/dev/null | head -1)
    [ -n "$mf" ] && [ -x "$mf/bin/mamba" ] || { echo "miniforge/mamba not found" >&2; return 1; }
    if [ ! -x /opt/sage/bin/sage ]; then
        "$mf/bin/mamba" create -y -q -p /opt/sage -c conda-forge sage >/dev/null
    fi
    chmod -R a+rX /opt/sage
    ln -sf /opt/sage/bin/sage /usr/local/bin/sage
    desktop_entry sagemath "SageMath" "/usr/local/bin/sage -n jupyter" "utilities-terminal" "SageMath (notebook Jupyter)"
}
step_webapps() {
    # Teams has no Linux client any more (Microsoft: use the PWA); Overleaf is
    # a web app. Both open in Google Chrome in app mode.
    log "Teams and Overleaf as Chrome web apps"
    command -v google-chrome-stable >/dev/null || { echo "google-chrome missing (run step chrome first)" >&2; return 1; }
    desktop_entry microsoft-teams "Microsoft Teams" "/usr/bin/google-chrome-stable --app=https://teams.microsoft.com" "google-chrome" "Teams (application web)"
    desktop_entry overleaf "Overleaf" "/usr/bin/google-chrome-stable --app=https://www.overleaf.com" "google-chrome" "Overleaf (LaTeX en ligne)"
    sed -i 's/^Categories=.*/Categories=Network;Office;/' /usr/share/applications/microsoft-teams.desktop /usr/share/applications/overleaf.desktop
}
step_dbimages() {
    log "Database images for aims-db (shared read-only Podman store)"
    for img in docker.io/library/postgres:17 docker.io/library/mariadb:11 docker.io/library/redis:7 docker.io/library/mongo:8; do
        podman pull -q "$img" >/dev/null
    done
    podman images --format "{{.Repository}}:{{.Tag}} {{.Size}}" | grep -E "postgres|mariadb|redis|mongo"
}

steps=("$@"); [ ${#steps[@]} -gt 0 ] || steps=(repos code chrome bruno zotero drawio julia ghidra android geogebra dbimages zoom rstudio sage webapps)
failed=""
for s in "${steps[@]}"; do
    if ! "step_$s"; then failed="$failed $s"; log "step $s FAILED (continuing)"; fi
done
[ -z "$failed" ] && log "done, all steps OK" || { log "done with failures:$failed"; exit 1; }
