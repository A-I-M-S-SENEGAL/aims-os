#!/bin/bash
# =============================================================================
# aims-labo-extras — vendor software for the lab golden machine (run once, root)
# =============================================================================
# Everything here comes from outside Debian: vendor apt repositories (kept
# up to date by apt afterwards) or upstream archives unpacked in /opt.
# Re-runnable: each step skips what is already there.
#
#   aims-labo-extras            everything
#   aims-labo-extras <step>...  only some steps: repos code chrome zotero bruno
#                               drawio julia ghidra android geogebra dbimages zoom rstudio sage webapps texlive anaconda
#                               nodejs dbeaver runtimes gnuplot climat reseau gns3 pdf acrobat
#                               packettracer vmimages
# =============================================================================
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "root required" >&2; exit 1; }
export DEBIAN_FRONTEND=noninteractive
KEYS=/usr/share/keyrings; LIST=/etc/apt/sources.list.d; ARCH=$(dpkg --print-architecture)
# IPv4 only: the campus has no IPv6 connectivity (see sysctl.d/60-aims-labo-ipv6.conf)
# Retries: the campus link drops a connection now and then (1 in 6 measured
# on 2026-09-07 from both a lab machine and the server).
curl() { command curl -4 --retry 6 --retry-delay 5 --retry-all-errors --connect-timeout 20 "$@"; }
export JAVA_TOOL_OPTIONS="-Djava.net.preferIPv4Stack=true"
log() { printf '\033[1;34m[aims-labo-extras]\033[0m %s\n' "$*"; }
need() { command -v "$1" >/dev/null 2>&1 || apt-get -q -y install "$1" >/dev/null; }
desktop_entry() { # name exec icon comment
    cat > "/usr/share/applications/$1.desktop" <<D
[Desktop Entry]
Type=Application
Name=$2
Exec=$3
Icon=$4
Comment=$5
Categories=Development;
Terminal=false
D
}

step_repos() {
    need curl; need gpg
    # keyring helper: always re-fetch (a truncated download once left an
    # unusable key behind) and refuse to keep a file gpg cannot read.
    fetch_key() { # url dest
        local tmp; tmp=$(mktemp)
        curl -fsSL "$1" -o "$tmp" && gpg --dearmor --yes -o "$2" "$tmp" && gpg --show-keys "$2" >/dev/null 2>&1 \
            || { rm -f "$2"; echo "key fetch failed: $1" >&2; rm -f "$tmp"; return 1; }
        rm -f "$tmp"; chmod 0644 "$2"
    }
    log "Microsoft (VS Code)"
    fetch_key https://packages.microsoft.com/keys/microsoft.asc $KEYS/microsoft.gpg
    echo "deb [arch=amd64,arm64 signed-by=$KEYS/microsoft.gpg] https://packages.microsoft.com/repos/code stable main" > $LIST/vscode.list
    log "Google (Chrome)"
    # Chrome's own package installs /etc/apt/sources.list.d/google-chrome.sources; ours only bootstraps
    if [ ! -f $LIST/google-chrome.sources ]; then
        fetch_key https://dl.google.com/linux/linux_signing_key.pub $KEYS/google-chrome.gpg
        echo "deb [arch=amd64 signed-by=$KEYS/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" > $LIST/google-chrome.list
    else
        rm -f $LIST/google-chrome.list
    fi
    log "Bruno"
    fetch_key "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x9FA6017ECABE0266" $KEYS/bruno.gpg
    echo "deb [signed-by=$KEYS/bruno.gpg] http://debian.usebruno.com/ bruno stable" > $LIST/bruno.list
    apt-get -q update 2>&1 | grep -E "^(E|W):" || true
}
step_code()   { log "VS Code";  apt-get -q -y install code >/dev/null; }
step_chrome() { log "Google Chrome"; apt-get -q -y install google-chrome-stable >/dev/null; }
step_bruno()  { log "Bruno (API client)"; apt-get -q -y install bruno >/dev/null; }
step_zotero() {
    log "Zotero (retorquere apt repo)"
    need curl
    if [ ! -f $LIST/zotero.list ] && [ ! -f $LIST/zotero.sources ]; then
        curl -fsSL https://raw.githubusercontent.com/retorquere/zotero-deb/master/install.sh | bash >/dev/null
        apt-get -q update >/dev/null
    fi
    apt-get -q -y install zotero >/dev/null
}
step_drawio() {
    log "draw.io desktop"
    need curl
    # No GitHub API (rate-limited per campus IP): follow the "latest" redirect to the tag.
    tag=$(curl -s -o /dev/null -w '%{redirect_url}' https://github.com/jgraph/drawio-desktop/releases/latest | grep -oE 'v[0-9.]+$')
    [ -n "$tag" ] || { echo "draw.io: latest tag not found" >&2; return 1; }
    url="https://github.com/jgraph/drawio-desktop/releases/download/${tag}/drawio-amd64-${tag#v}.deb"
    # the package is named "draw.io"
    dpkg -s draw.io 2>/dev/null | grep -q "^Version: ${tag#v}" && return 0
    curl -fsSL -o /tmp/drawio.deb "$url" && apt-get -q -y install /tmp/drawio.deb 2>&1 | grep -E "^(E:|Setting up draw)" ; rm -f /tmp/drawio.deb
    dpkg -s draw.io >/dev/null 2>&1
}
step_julia() {
    log "Julia (official binaries, /opt/julia)"
    need curl; need python3
    read -r ver url sha < <(curl -fsSL https://julialang-s3.julialang.org/bin/versions.json | python3 -c '
import json,sys
d=json.load(sys.stdin)
stable=[v for v,i in d.items() if i.get("stable")]
stable.sort(key=lambda v:[int(x) for x in v.split(".")])
v=stable[-1]
for f in d[v]["files"]:
    if f["os"]=="linux" and f["arch"]=="x86_64" and f["kind"]=="archive": print(v,f["url"],f["sha256"]); break')
    if [ -x /opt/julia/bin/julia ] && /opt/julia/bin/julia --version | grep -q "$ver"; then return 0; fi
    curl -fsSL -o /tmp/julia.tgz "$url"; echo "$sha  /tmp/julia.tgz" | sha256sum -c --quiet
    rm -rf /opt/julia && mkdir -p /opt/julia && tar -xzf /tmp/julia.tgz -C /opt/julia --strip-components=1 && rm -f /tmp/julia.tgz
    ln -sf /opt/julia/bin/julia /usr/local/bin/julia
}
step_ghidra() {
    log "Ghidra (GitHub release, /opt/ghidra)"
    need curl; need unzip; apt-get -q -y install default-jdk >/dev/null
    url=$(curl -fsSL https://api.github.com/repos/NationalSecurityAgency/ghidra/releases/latest | grep -oE 'https://[^"]+ghidra_[0-9.]+_PUBLIC_[0-9]+\.zip' | head -1)
    [ -n "$url" ] || { echo "ghidra: release URL not found" >&2; return 1; }
    ver=$(echo "$url" | grep -oE 'ghidra_[0-9.]+_PUBLIC')
    [ -f "/opt/ghidra/.version" ] && [ "$(cat /opt/ghidra/.version)" = "$ver" ] && return 0
    curl -fsSL -o /tmp/ghidra.zip "$url"; rm -rf /opt/ghidra /tmp/ghidra-x && mkdir -p /tmp/ghidra-x && unzip -q /tmp/ghidra.zip -d /tmp/ghidra-x
    mv /tmp/ghidra-x/ghidra_* /opt/ghidra && echo "$ver" > /opt/ghidra/.version && rm -rf /tmp/ghidra.zip /tmp/ghidra-x
    chmod +x /opt/ghidra/ghidraRun
    desktop_entry ghidra "Ghidra" "/opt/ghidra/ghidraRun" "/opt/ghidra/support/ghidra.ico" "Rétro-ingénierie (NSA)"
}
step_android() {
    log "Android Studio + shared SDK (/opt/android-studio, /opt/android-sdk)"
    need curl; need unzip; apt-get -q -y install default-jdk libc6:i386 2>/dev/null || true
    # The page carries the real Linux archive URL, e.g.
    # https://edgedl.me.gvt1.com/android/studio/ide-zips/2026.1.4.7/android-studio-quail4-linux.tar.gz
    page=$(curl -fsSL https://developer.android.com/studio)
    url=$(echo "$page" | grep -oE 'https://[a-zA-Z0-9./_-]*/ide-zips/[0-9.]+/android-studio-[a-zA-Z0-9._-]+-linux\.tar\.gz' | head -1)
    [ -n "$url" ] || { echo "android studio: Linux archive URL not found on developer.android.com" >&2; return 1; }
    sver=$(echo "$url" | grep -oE 'ide-zips/[0-9.]+' | cut -d/ -f2)
    ver="android-studio-${sver}"
    if [ ! -f /opt/android-studio/.version ] || [ "$(cat /opt/android-studio/.version)" != "$ver" ]; then
        curl -fL -o /tmp/android-studio.tgz "$url"
        rm -rf /opt/android-studio && tar -xzf /tmp/android-studio.tgz -C /opt && echo "$ver" > /opt/android-studio/.version && rm -f /tmp/android-studio.tgz
        desktop_entry android-studio "Android Studio" "/opt/android-studio/bin/studio.sh" "/opt/android-studio/bin/studio.png" "IDE Android (Google)"
    fi
    # shared SDK
    # Command-line tools: newest name listed in Google's repository manifest.
    tname=$(curl -fsSL https://dl.google.com/android/repository/repository2-3.xml | grep -oE 'commandlinetools-linux-[0-9]+_latest\.zip' | sort -t- -k3 -n | tail -1)
    tools="https://dl.google.com/android/repository/${tname}"
    [ -n "$tname" ] || { echo "android sdk: command-line tools name not found" >&2; return 1; }
    mkdir -p /opt/android-sdk/cmdline-tools
    if [ ! -x /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager ]; then
        curl -fL -o /tmp/cmdtools.zip "$tools" && rm -rf /tmp/cmdtools && unzip -q /tmp/cmdtools.zip -d /tmp/cmdtools
        rm -rf /opt/android-sdk/cmdline-tools/latest && mv /tmp/cmdtools/cmdline-tools /opt/android-sdk/cmdline-tools/latest && rm -rf /tmp/cmdtools /tmp/cmdtools.zip
    fi
    export ANDROID_HOME=/opt/android-sdk
    yes | /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager --sdk_root=/opt/android-sdk --licenses >/dev/null 2>&1 || true
    /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager --sdk_root=/opt/android-sdk \
        "platform-tools" "platforms;android-35" "build-tools;35.0.0" "emulator" \
        "system-images;android-35;google_apis;x86_64" >/dev/null
    chmod -R a+rX /opt/android-sdk
    # Studio must not try to write the shared SDK; students keep AVDs/caches in their home
    install -d -m 0755 /etc/skel/.config/Google 2>/dev/null || true
}
step_geogebra() {
    log "GeoGebra (Flatpak, system-wide)"
    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
    flatpak install -y --noninteractive --system flathub org.geogebra.GeoGebra >/dev/null
}
step_zoom() {
    log "Zoom (deb from zoom.us)"
    curl -fsSL -o /tmp/zoom.deb https://zoom.us/client/latest/zoom_amd64.deb
    local newv; newv=$(dpkg-deb -f /tmp/zoom.deb Version 2>/dev/null)
    if [ -n "$newv" ] && [ "$(dpkg-query -W -f='${Version}' zoom 2>/dev/null)" = "$newv" ]; then rm -f /tmp/zoom.deb; return 0; fi
    apt-get -q -y install /tmp/zoom.deb 2>&1 | grep -E "^(E:|Setting up zoom)"; rm -f /tmp/zoom.deb
    dpkg -s zoom >/dev/null 2>&1
}
step_rstudio() {
    # The welcome script pins one version, so RStudio never moved and the
    # students saw its "Update Available" box (9 September 2026). Read the
    # current Debian/Ubuntu 22 build from Posit's download page instead and
    # install it when it is newer than what dpkg has.
    log "RStudio (Posit, latest Debian/Ubuntu 22 build)"
    need curl
    local url ver cur
    url=$(curl -fsSL https://posit.co/download/rstudio-desktop/ | grep -oE 'https://download1\.rstudio\.org/electron/jammy/amd64/rstudio-[0-9.]+-[0-9]+-amd64\.deb' | head -1)
    if [ -z "$url" ]; then
        # fall back to the pinned welcome script rather than fail
        local rs; rs=$(ls /usr/share/aims-os/install/rstudio.sh /usr/share/aims-os/install/install/rstudio.sh 2>/dev/null | head -1)
        [ -n "$rs" ] && { "$rs" >/dev/null 2>&1 || "$rs"; }
        dpkg -s rstudio >/dev/null 2>&1; return
    fi
    ver=$(echo "$url" | grep -oE 'rstudio-[0-9.]+-[0-9]+' | sed 's/^rstudio-//; s/-\([0-9]*\)$/+\1/')   # 2026.08.2+200
    cur=$(dpkg-query -W -f='${Version}' rstudio 2>/dev/null || true)
    if [ -n "$cur" ] && dpkg --compare-versions "$cur" ge "$ver"; then return 0; fi
    curl -fL -o /tmp/rstudio.deb "$url" && apt-get -q -y install /tmp/rstudio.deb 2>&1 | grep -E "^(E:|Setting up rstudio)"; rm -f /tmp/rstudio.deb
    dpkg -s rstudio >/dev/null 2>&1
}
step_sage() {
    # SageMath is not installable from Debian 13 (Python 3.13 mismatch);
    # conda-forge ships it. One shared environment under /opt/sage.
    log "SageMath (conda-forge, /opt/sage, ~4 GB)"
    local mf; mf=$(ls -d /opt/miniforge* /opt/conda 2>/dev/null | head -1)
    [ -n "$mf" ] && [ -x "$mf/bin/mamba" ] || { echo "miniforge/mamba not found" >&2; return 1; }
    if [ ! -x /opt/sage/bin/sage ]; then
        "$mf/bin/mamba" create -y -q -p /opt/sage -c conda-forge sage >/dev/null
    fi
    chmod -R a+rX /opt/sage
    ln -sf /opt/sage/bin/sage /usr/local/bin/sage
    local ic; ic=$(ls /opt/sage/share/jupyter/kernels/sagemath*/logo-64x64.png 2>/dev/null | head -1)
    desktop_entry sagemath "SageMath" "/usr/local/bin/sage -n jupyter" "${ic:-utilities-terminal}" "SageMath (notebook Jupyter)"
}
step_webapps() {
    # Teams has no Linux client any more (Microsoft: use the PWA); Overleaf is
    # a web app. Both open in Google Chrome in app mode.
    log "Teams and Overleaf as Chrome web apps"
    command -v google-chrome-stable >/dev/null || { echo "google-chrome missing (run step chrome first)" >&2; return 1; }
    desktop_entry microsoft-teams "Microsoft Teams" "/usr/bin/google-chrome-stable --app=https://teams.microsoft.com" "google-chrome" "Teams (application web)"
    desktop_entry overleaf "Overleaf" "/usr/bin/google-chrome-stable --app=https://www.overleaf.com" "google-chrome" "Overleaf (LaTeX en ligne)"
    sed -i 's/^Categories=.*/Categories=Network;Office;/' /usr/share/applications/microsoft-teams.desktop /usr/share/applications/overleaf.desktop
}
step_texlive() {
    log "TeX Live complet (texlive-full, Debian)"
    apt-get -q -y install texlive-full 2>&1 | grep -E "^(E:|Setting up texlive-full)"
    dpkg -s texlive-full >/dev/null 2>&1
}
step_anaconda() {
    # Anaconda Distribution, free for accredited educational institutions
    # (Anaconda Academic Policy, 2026). Installed in /opt/anaconda3 next to
    # Miniforge (which stays the default `conda`); Navigator gets a launcher.
    log "Anaconda Distribution (/opt/anaconda3, ~7 GB)"
    local page name sha
    page=$(curl -fsSL https://repo.anaconda.com/archive/)
    name=$(echo "$page" | grep -oE 'Anaconda3-20[0-9]{2}\.[0-9]+-[0-9]+-Linux-x86_64\.sh' | sort -u | tail -1)
    [ -n "$name" ] || { echo "anaconda: installer name not found" >&2; return 1; }
    if [ -f /opt/anaconda3/.installed ] && [ "$(cat /opt/anaconda3/.installed)" = "$name" ]; then return 0; fi
    sha=$(echo "$page" | tr -d '\n' | grep -oE "${name}</a>.{0,400}" | grep -oE '[0-9a-f]{64}' | head -1)
    curl -fSL -o /tmp/anaconda.sh "https://repo.anaconda.com/archive/${name}"
    if [ -n "$sha" ]; then echo "${sha}  /tmp/anaconda.sh" | sha256sum -c --quiet || { echo "anaconda: checksum mismatch" >&2; rm -f /tmp/anaconda.sh; return 1; }; fi
    rm -rf /opt/anaconda3 && bash /tmp/anaconda.sh -b -p /opt/anaconda3 >/dev/null && rm -f /tmp/anaconda.sh
    echo "$name" > /opt/anaconda3/.installed
    chmod -R a+rX /opt/anaconda3
    local ic; ic=$(find /opt/anaconda3/lib/python3.*/site-packages/anaconda_navigator/static/images -name "anaconda-icon-256x256.png" 2>/dev/null | head -1)  # 2026.07 moved it under common/
    desktop_entry anaconda-navigator "Anaconda Navigator" "/opt/anaconda3/bin/anaconda-navigator" "${ic:-anaconda-navigator}" "Anaconda Distribution (Navigator, Spyder, JupyterLab)"
    sed -i 's/^Categories=.*/Categories=Development;Science;/' /usr/share/applications/anaconda-navigator.desktop
    # `conda` reste Miniforge ; Anaconda s'active avec : source /opt/anaconda3/bin/activate
}
aims_script() { # run one of the aims-os-welcome install scripts (either path layout)
    local sc; sc=$(ls "/usr/share/aims-os/install/$1" "/usr/share/aims-os/install/install/$1" 2>/dev/null | head -1)
    [ -n "$sc" ] || { echo "$1 missing (aims-os-welcome)" >&2; return 1; }
    "$sc" >/dev/null 2>&1 || "$sc"
}
step_nodejs()   { log "Node.js LTS (NodeSource, script AIMS OS)"; aims_script nodejs.sh; node --version >/dev/null 2>&1; }
step_dbeaver()  { log "DBeaver CE (dbeaver.io, script AIMS OS)"; aims_script dbeaver.sh; dpkg -s dbeaver-ce >/dev/null 2>&1; }
step_runtimes() { log "Bun, Deno, uv (script AIMS OS)"; aims_script runtimes.sh; command -v bun >/dev/null && command -v deno >/dev/null && command -v uv >/dev/null; }
step_gnuplot()  { log "gnuplot"; apt-get -q -y install gnuplot >/dev/null; dpkg -s gnuplot >/dev/null 2>&1; }
step_packettracer() {
    # Cisco Packet Tracer: the .deb is not redistributable; the IT team fetches
    # it once from NetAcad and drops it on the campus server (FOG web root,
    # /var/www/html/aims/). Students sign in with their own NetAcad account.
    log "Cisco Packet Tracer (from the campus server)"
    local base=http://192.168.10.240/aims name
    name=$(curl -fsSL "$base/" | grep -oE 'CiscoPacketTracer_[0-9]+_Ubuntu_64bit\.deb' | sort -u | tail -1)
    [ -n "$name" ] || { echo "packet tracer: no .deb on $base/ (upload it there first)" >&2; return 1; }
    local ver; ver=$(echo "$name" | grep -oE '_[0-9]+_' | tr -d _)
    if dpkg -s packettracer >/dev/null 2>&1 && dpkg-query -W -f='${Version}' packettracer | tr -d . | grep -q "^${ver}"; then
        /usr/lib/aims-os/packettracer-fix; return 0
    fi
    curl -fsSL -o /tmp/packettracer.deb "$base/$name"
    echo "packettracer packettracer/eula boolean true" | debconf-set-selections 2>/dev/null || true
    echo "packettracer packettracer/show-eula boolean false" | debconf-set-selections 2>/dev/null || true
    apt-get -q -y install /tmp/packettracer.deb 2>&1 | grep -E "^(E:|Setting up packettracer)"; rm -f /tmp/packettracer.deb
    /usr/lib/aims-os/packettracer-fix
    dpkg -s packettracer >/dev/null 2>&1
}
step_climat() {
    # Climate science teaching set, all from Debian 13: NetCDF and GRIB
    # readers, the two command line toolboxes every course uses, and the
    # Python side (MetPy, cfgrib, eccodes, xarray, cartopy).
    log "Climate tools (cdo, nco, ncview, NetCDF, GRIB, MetPy)"
    apt-get -q -y install cdo nco ncview netcdf-bin hdf5-tools grads \
        python3-metpy python3-eccodes python3-cfgrib python3-xarray \
        python3-cartopy python3-netcdf4 >/dev/null
    command -v cdo >/dev/null && command -v ncview >/dev/null
}

step_reseau() {
    # Network teaching set from Debian 13. GNS3 itself is not packaged, see
    # step_gns3.
    log "Network tools (FRR, Mininet, Open vSwitch, iperf3, mtr, VPCS)"
    apt-get -q -y install frr frr-pythontools mininet openvswitch-switch \
        iperf3 mtr tcpdump vpcs traceroute nmap >/dev/null
    # FRR ships disabled; a classroom router is started by hand during the
    # lab, so only make sure the daemons file exists.
    command -v vtysh >/dev/null && command -v mn >/dev/null
}

step_gns3() {
    # GNS3 has no Debian package. Upstream ships Python wheels, and the two
    # helpers it needs, dynamips and ubridge, are not in Debian 13 either, so
    # they are built here. --system-site-packages lets the GUI find the
    # system PyQt6 instead of building it.
    log "GNS3 (pipx + dynamips and ubridge built from source)"
    apt-get -q -y install pipx python3-pyqt6 python3-pyqt6.qtsvg python3-pyqt6.qtwebsockets \
        xterm build-essential cmake libelf-dev libpcap-dev uuid-dev git imagemagick >/dev/null
    export PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin
    for pkg in gns3-server gns3-gui; do
        if [ -d "/opt/pipx/venvs/$pkg" ]; then
            pipx upgrade "$pkg" >/dev/null 2>&1 || true
        else
            pipx install --system-site-packages "$pkg" >/dev/null || return 1
        fi
    done
    # The campus link drops one connection in six, and a git clone does not
    # retry on its own.
    clone_retry() { # url dest
        local i
        for i in 1 2 3 4; do
            git clone -q --depth 1 "$1" "$2" && return 0
            rm -rf "$2"; sleep 10
        done
        echo "clone failed: $1" >&2; return 1
    }
    # ubridge: bridges a virtual machine interface to a capture interface.
    if ! command -v ubridge >/dev/null; then
        local d; d=$(mktemp -d)
        clone_retry https://github.com/GNS3/ubridge.git "$d/ubridge" \
            && make -s -C "$d/ubridge" >/dev/null 2>&1 \
            && install -m 0755 "$d/ubridge/ubridge" /usr/local/bin/ubridge
        rm -rf "$d"
    fi
    # Capabilities rather than setuid root, and no password to type.
    [ -x /usr/local/bin/ubridge ] && setcap cap_net_admin,cap_net_raw=ep /usr/local/bin/ubridge 2>/dev/null || true
    # dynamips: emulates the Cisco routers GNS3 drives.
    if ! command -v dynamips >/dev/null; then
        local d; d=$(mktemp -d)
        if clone_retry https://github.com/GNS3/dynamips.git "$d/dynamips"; then
            ( cd "$d/dynamips" && mkdir -p build && cd build \
              && cmake -DCMAKE_BUILD_TYPE=Release .. >/dev/null 2>&1 \
              && make -s -j"$(nproc)" >/dev/null 2>&1 && make install >/dev/null 2>&1 )
        fi
        rm -rf "$d"
    fi
    ldconfig 2>/dev/null || true
    # The GUI ships its own icon set inside the venv; copy it where the
    # desktop can find it (a venv path would break on the next upgrade).
    local src
    for size in 16x16 22x22 24x24 32x32 48x48 64x64 128x128 256x256 scalable; do
        src=$(ls /opt/pipx/venvs/gns3-gui/lib/python3*/site-packages/gns3/linux/icons/hicolor/$size/apps/gns3.* 2>/dev/null | head -1)
        [ -n "$src" ] && install -D -m 644 "$src" "/usr/share/icons/hicolor/$size/apps/gns3.${src##*.}"
    done
    # Upstream ships 16, 32 and 48 pixels only, so the app grid, which draws
    # icons much larger, was blowing up the 48 pixel one. Render the vector
    # file at the sizes GNOME actually uses.
    if command -v magick >/dev/null 2>&1 && [ -f /usr/share/icons/hicolor/scalable/apps/gns3.svg ]; then
        for s in 64 96 128 256 512; do
            magick -background none /usr/share/icons/hicolor/scalable/apps/gns3.svg \
                -resize ${s}x${s} "/tmp/gns3-$s.png" 2>/dev/null \
                && install -D -m 644 "/tmp/gns3-$s.png" "/usr/share/icons/hicolor/${s}x${s}/apps/gns3.png"
            rm -f "/tmp/gns3-$s.png"
        done
    fi
    gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
    desktop_entry gns3 "GNS3" "/usr/local/bin/gns3" "gns3" "GNS3 (simulation réseau)"
    sed -i 's/^Categories=.*/Categories=Education;Network;/' /usr/share/applications/gns3.desktop
    command -v gns3 >/dev/null && command -v gns3server >/dev/null
}

step_pdf() {
    # PDF work beyond plain reading: forms, annotations, signatures, merging,
    # OCR of scanned documents. All from Debian 13.
    # Government forms (visa applications, tax forms) are often XFA PDFs,
    # which Evince and Okular cannot render; Firefox's built-in viewer can,
    # its XFA engine was written for exactly those forms. Firefox does not
    # declare application/pdf on Debian, so the launcher below makes it
    # appear in "Open with".
    log "PDF tools (Okular, Xournal++, PDF Arranger, OCRmyPDF) and a Firefox forms launcher"
    apt-get -q -y install okular xournalpp pdfarranger ocrmypdf \
        tesseract-ocr-fra tesseract-ocr-eng qpdf pdfsam >/dev/null
    cat > /usr/share/applications/aims-pdf-formulaire.desktop <<'D'
[Desktop Entry]
Type=Application
Name=Formulaire PDF (Firefox)
Name[en]=PDF form (Firefox)
Comment=Ouvre un formulaire administratif (visa, impôts) dans Firefox, qui gère les formulaires XFA
Comment[en]=Open a government form (visa, tax) in Firefox, which handles XFA forms
Exec=firefox-esr --new-window %f
Icon=firefox-esr
Terminal=false
MimeType=application/pdf;
Categories=Office;Viewer;
NoDisplay=false
D
    update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
    command -v okular >/dev/null && command -v xournalpp >/dev/null && command -v ocrmypdf >/dev/null
}

step_acrobat() {
    # Adobe Acrobat Reader DC (Windows build) under Wine, asked by Hakim on
    # 8 September 2026 for the XFA forms of immigration and tax offices,
    # which no Linux reader renders. Adobe dropped its Linux reader in 2013.
    # Reader DC is 32-bit: i386 multiarch plus wine32. One template prefix is
    # built here, root owned; /usr/bin/aims-acrobat copies it per account.
    # Version 20.013.20064 is the last classic 32-bit release reported to run
    # under Wine; the unified 64-bit Acrobat (2021+) does not.
    log "Adobe Acrobat Reader DC under Wine (/opt/acrobat, ~1.5 GB)"
    local ver=2001320064 lang=fr_FR
    local url="https://ardownload2.adobe.com/pub/adobe/reader/win/AcrobatDC/$ver/AcroRdrDC${ver}_$lang.exe"
    if [ -f /opt/acrobat/prefix/.aims-version ] && [ "$(cat /opt/acrobat/prefix/.aims-version)" = "$ver" ]; then
        return 0
    fi
    if ! dpkg --print-foreign-architectures | grep -q i386; then
        dpkg --add-architecture i386
        # Vendor repositories that publish amd64 only would now warn about a
        # missing i386 index on every apt update: pin them to amd64.
        for f in /etc/apt/sources.list.d/*.list; do
            [ -f "$f" ] || continue
            grep -q "arch=" "$f" || sed -i -E 's/^deb (\[)?/deb [arch=amd64 /; s/\[arch=amd64 \[/[arch=amd64 /' "$f"
        done
        for f in /etc/apt/sources.list.d/*.sources; do
            [ -f "$f" ] || continue
            grep -qi "^Architectures:" "$f" || sed -i '/^URIs:/i Architectures: amd64' "$f"
        done
        apt-get -q update >/dev/null
    fi
    apt-get -q -y install wine wine32:i386 wine64 fonts-wine cabextract icoutils imagemagick >/dev/null
    command -v wineserver >/dev/null || { echo "acrobat: wine incomplet (installation apt échouée ?)" >&2; return 1; }
    if [ ! -x /usr/local/bin/winetricks ]; then
        # winetricks sits in Debian contrib, which the lab does not enable
        curl -fsSL -o /usr/local/bin/winetricks https://raw.githubusercontent.com/Winetricks/winetricks/master/src/winetricks
        chmod 0755 /usr/local/bin/winetricks
    fi
    export WINEPREFIX=/opt/acrobat/prefix WINEARCH=win32 WINEDEBUG=-all WINEDLLOVERRIDES="mscoree,mshtml="
    rm -rf /opt/acrobat; install -d -m 0755 /opt/acrobat
    wineboot -i >/dev/null 2>&1
    # fonts, rich edit and script hosts Reader expects; corefonts for the forms
    winetricks -q -f atmlib riched20 wsh57 mspatcha msftedit corefonts >/dev/null 2>&1 || true
    winetricks -q win10 >/dev/null 2>&1 || true
    curl -fL -o /tmp/AcroRdrDC.exe "$url"
    # /sAll silent, /rs no reboot, EULA accepted on behalf of the institution
    wine /tmp/AcroRdrDC.exe /sAll /rs /msi EULA_ACCEPT=YES >/dev/null 2>&1 || true
    timeout 120 wineserver -w 2>/dev/null || wineserver -k 2>/dev/null || true; rm -f /tmp/AcroRdrDC.exe
    [ -f "/opt/acrobat/prefix/drive_c/Program Files/Adobe/Acrobat Reader DC/Reader/AcroRd32.exe" ] \
        || { echo "acrobat: AcroRd32.exe missing after install" >&2; return 1; }
    # no updater (it cannot work here) and no protected mode (breaks under Wine)
    cat > /tmp/acro.reg <<'R'
REGEDIT4

[HKEY_LOCAL_MACHINE\Software\Adobe\Adobe ARM\1.0\ARM]
"iCheckReader"=dword:00000000

[HKEY_LOCAL_MACHINE\Software\Adobe\Adobe ARM\Legacy\Reader\{AC76BA86-7AD7-1033-7B44-AC0F074E4100}]
"Mode"=dword:00000000

[HKEY_CURRENT_USER\Software\Adobe\Acrobat Reader\DC\Privileged]
"bProtectedMode"=dword:00000000

[HKEY_CURRENT_USER\Software\Adobe\Acrobat Reader\DC\AVGeneral]
"bDisplayAboutDialog"=dword:00000000

[HKEY_CURRENT_USER\Software\Wine\WineDbg]
"ShowCrashDialog"=dword:00000000

[HKEY_LOCAL_MACHINE\System\ControlSet001\Services\AdobeARMservice]
"Start"=dword:00000004
R
    # RdrCEF, the embedded Chromium behind the cloud "Home" page and the
    # sign-in dialogs, crashes under Wine (seen 8 September 2026: "Program
    # Error" over a PDF that was otherwise displayed fine). Reader works
    # without it; the four RdrCEF processes and the crash go away.
    local cef="/opt/acrobat/prefix/drive_c/Program Files/Adobe/Acrobat Reader DC/Reader/AcroCEF/RdrCEF.exe"
    [ -f "$cef" ] && mv "$cef" "$cef.disabled"
    # armsvc, the update service: cannot update anything here and keeps a
    # process alive in every session. Wine keeps services under ControlSet001.
    local arm="/opt/acrobat/prefix/drive_c/Program Files/Common Files/Adobe/ARM/1.0/armsvc.exe"
    [ -f "$arm" ] && mv "$arm" "$arm.disabled"
    wine regedit /S /tmp/acro.reg >/dev/null 2>&1; timeout 120 wineserver -w 2>/dev/null || wineserver -k 2>/dev/null || true; rm -f /tmp/acro.reg
    # icon from the executable, for the launcher
    local ico; ico=$(mktemp -d)
    wrestool -x -t 14 -o "$ico" "/opt/acrobat/prefix/drive_c/Program Files/Adobe/Acrobat Reader DC/Reader/AcroRd32.exe" 2>/dev/null || true
    local first; first=$(ls "$ico"/*.ico 2>/dev/null | head -1)
    if [ -n "$first" ] && command -v magick >/dev/null 2>&1; then
        magick "$first[0]" -resize 256x256 /usr/share/icons/hicolor/256x256/apps/aims-acrobat.png 2>/dev/null \
            && gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1
    fi
    rm -rf "$ico"
    echo "$ver" > /opt/acrobat/prefix/.aims-version
    chmod -R a+rX /opt/acrobat
    cat > /usr/share/applications/aims-acrobat.desktop <<'D'
[Desktop Entry]
Type=Application
Name=Adobe Acrobat Reader
Comment=Lecteur Adobe (Windows, via Wine) pour les formulaires XFA des administrations
Comment[en]=Adobe Reader (Windows build, via Wine) for XFA government forms
Exec=/usr/bin/aims-acrobat %f
Icon=aims-acrobat
Terminal=false
MimeType=application/pdf;
Categories=Office;Viewer;
D
    update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
}

step_vmimages() {
    # Base images for aims-vm: the Cisco Cybersecurity LabVM (converted from
    # Cisco's OVA by IT, served from the campus server) and a Debian 13
    # cloud image customised as a root sandbox (built by IT on the server).
    log "VM base images for aims-vm (/var/lib/aims-os/vm)"
    local base=http://192.168.10.240/aims/vm; install -d -m 0755 /var/lib/aims-os/vm
    for img in cisco-cyberlab.qcow2 cisco-cyberlab-disk2.qcow2 debian-13.qcow2; do
        local remote_sha; remote_sha=$(curl -fsSL "$base/$img.sha256" 2>/dev/null | cut -d' ' -f1) || continue
        [ -n "$remote_sha" ] || continue
        if [ -f "/var/lib/aims-os/vm/$img" ] && [ "$(cat /var/lib/aims-os/vm/$img.sha256 2>/dev/null)" = "$remote_sha" ]; then continue; fi
        curl -fL -o "/var/lib/aims-os/vm/$img.part" "$base/$img" && echo "$remote_sha  /var/lib/aims-os/vm/$img.part" | sha256sum -c --quiet             && mv "/var/lib/aims-os/vm/$img.part" "/var/lib/aims-os/vm/$img" && echo "$remote_sha" > "/var/lib/aims-os/vm/$img.sha256"             || { rm -f "/var/lib/aims-os/vm/$img.part"; echo "vm image $img: download/checksum failed" >&2; }
    done
    chmod 0644 /var/lib/aims-os/vm/*.qcow2 2>/dev/null || true
    ls /var/lib/aims-os/vm/*.qcow2 >/dev/null 2>&1
}
step_dbimages() {
    log "Database images for aims-db (shared read-only Podman store)"
    for img in docker.io/library/postgres:17 docker.io/library/mariadb:11 docker.io/library/redis:7 docker.io/library/mongo:8; do
        podman pull -q "$img" >/dev/null
    done
    podman images --format "{{.Repository}}:{{.Tag}} {{.Size}}" | grep -E "postgres|mariadb|redis|mongo"
}

steps=("$@"); [ ${#steps[@]} -gt 0 ] || steps=(repos code chrome bruno zotero drawio julia ghidra android geogebra dbimages zoom rstudio sage webapps texlive anaconda nodejs dbeaver runtimes gnuplot climat reseau gns3 pdf acrobat packettracer vmimages)
failed=""
for s in "${steps[@]}"; do
    if ! "step_$s"; then failed="$failed $s"; log "step $s FAILED (continuing)"; fi
done
[ -z "$failed" ] && log "done, all steps OK" || { log "done with failures:$failed"; exit 1; }
