#!/bin/bash
# aims-labo-ensure — remet en place ce dont l'équipe IT a besoin sur un poste
# du labo (clé SSH IT et sa politique, pare-feu, GRUB, compte local, veille,
# journaux). Lancé toutes les heures par aims-labo-ensure.timer. Les étudiants
# ont sudo (décision du 7 septembre 2026) : ce script répare les maladresses
# et signale les réparations au serveur (syslog local5).
set -u
export DEBIAN_FRONTEND=noninteractive
PKG=aims-os-centre-senegal-labo
fixed=()
note() { logger -t aims-labo-ensure -p local5.notice -- "$*"; }
# 1. Fichiers livrés par le paquet modifiés ou absents → réinstallation
if ! dpkg -V "$PKG" >/dev/null 2>&1 || [ -n "$(dpkg -V "$PKG" 2>/dev/null)" ]; then
    apt-get -q -y install --reinstall -o Dpkg::Options::=--force-confnew -o Dpkg::Options::=--force-confmiss "$PKG" >/dev/null 2>&1 && fixed+=("paquet-labo")
fi
# 2. Services
# Un poste fraîchement cloné n'a plus de clés d'hôte SSH (retirées avant la
# capture) : sans elles sshd refuse de démarrer.
if ! ls /etc/ssh/ssh_host_*_key >/dev/null 2>&1; then ssh-keygen -A >/dev/null 2>&1; fixed+=("ssh-cles-hote"); fi
# sshd -t exige /run/sshd, que systemd ne crée qu'au premier démarrage réussi
# du service : sans lui la vérification échoue à tort (vu le 8 septembre 2026).
install -d -m 0755 /run/sshd 2>/dev/null || true
systemctl is-enabled ssh >/dev/null 2>&1 || { systemctl enable ssh >/dev/null 2>&1; fixed+=("ssh-enable"); }
systemctl is-active ssh >/dev/null 2>&1 || { systemctl start ssh >/dev/null 2>&1; fixed+=("ssh-start"); }
# aimsit : clé uniquement, même si un étudiant (sudo) lui pose un mot de
# passe local. Un bloc Match doit clore le fichier principal : dans un
# drop-in il avalerait la suite de sshd_config.
if ! grep -q "^Match User aimsit" /etc/ssh/sshd_config; then
    printf '\n# aims-os-centre-senegal-labo : le compte IT local entre par clé seulement\nMatch User aimsit\n    PasswordAuthentication no\n    KbdInteractiveAuthentication no\n' >> /etc/ssh/sshd_config
    sshd -t 2>/dev/null && systemctl reload ssh >/dev/null 2>&1
    fixed+=("sshd-match-aimsit")
fi
sshd -t 2>/dev/null || fixed+=("sshd-config-INVALIDE($(sshd -t 2>&1 | head -1 | tr -d '\n' | cut -c1-70))")
ufw status 2>/dev/null | grep -q "Status: active" || { ufw --force enable >/dev/null 2>&1; fixed+=("ufw-enable"); }
ufw status 2>/dev/null | grep -q "192.168.10.0/24" || { ufw limit from 192.168.10.0/24 to any port 22 proto tcp >/dev/null 2>&1; fixed+=("ufw-ssh-rule"); }
for t in sleep.target suspend.target hibernate.target hybrid-sleep.target; do
    [ "$(systemctl is-enabled $t 2>/dev/null)" = "masked" ] || { ln -sf /dev/null /etc/systemd/system/$t; fixed+=("mask-$t"); }
done
systemctl is-enabled systemd-timesyncd >/dev/null 2>&1 || { systemctl enable --now systemd-timesyncd >/dev/null 2>&1; fixed+=("timesyncd"); }
systemctl is-active rsyslog >/dev/null 2>&1 || { systemctl enable --now rsyslog >/dev/null 2>&1; fixed+=("rsyslog"); }
systemctl is-active sssd >/dev/null 2>&1 || { systemctl enable --now sssd >/dev/null 2>&1; fixed+=("sssd"); }
# 3. Comptes
getent passwd aimsit >/dev/null || { adduser --quiet --disabled-password --gecos "AIMS IT" --shell /bin/bash aimsit; fixed+=("aimsit-recree"); }
getent group aims-ssh >/dev/null || { addgroup --quiet --system aims-ssh; fixed+=("groupe-aims-ssh"); }
id -nG aimsit 2>/dev/null | grep -qw aims-ssh || { adduser --quiet aimsit aims-ssh >/dev/null 2>&1; fixed+=("aimsit-aims-ssh"); }
[ "$(passwd -S aimsit 2>/dev/null | awk '{print $2}')" = "L" ] || { passwd -l aimsit >/dev/null 2>&1; fixed+=("aimsit-lock"); }
if getent passwd aims >/dev/null; then
    [ "$(passwd -S aims | awk '{print $2}')" = "L" ] || { passwd -l aims >/dev/null 2>&1; fixed+=("aims-lock"); }
    id -nG aims | grep -qw sudo && { gpasswd -d aims sudo >/dev/null 2>&1; fixed+=("aims-sudo-retire"); }
fi
# 4. GRUB : mot de passe et entrées libres
if [ -s /etc/aims-os/grub-password.pbkdf2 ]; then
    grep -q "set superusers" /boot/grub/grub.cfg 2>/dev/null || { update-grub >/dev/null 2>&1; fixed+=("grub-cfg"); }
else
    fixed+=("grub-password-ABSENT")
fi
# 3b. Dossiers personnels : 0700. Les étudiants ont sudo, un « chmod 777 »
# sur un dossier personnel ouvrirait les fichiers de la personne à toute la
# promotion. Pour lire les fichiers d'un étudiant, l'équipe IT passe par sudo,
# qui lit sans changer les droits et laisse une trace dans le journal central.
for home in /home/*; do
    [ -d "$home" ] || continue
    perms=$(stat -c %a "$home" 2>/dev/null) || continue
    case "$perms" in
        700|750) ;;
        *) chmod 0700 "$home" 2>/dev/null && fixed+=("droits-$(basename "$home")") ;;
    esac
done
# 4a. Paramètres > Utilisateurs masqué de la recherche d'applications (il ne
# sait pas changer un mot de passe de l'annuaire) ; remis par le postinst.
UPANEL=/usr/share/applications/gnome-user-accounts-panel.desktop
if [ -f "${UPANEL}.dpkg-divert-aims" ] && ! grep -q '^NoDisplay=true' "$UPANEL" 2>/dev/null; then
    { grep -v '^NoDisplay=' "${UPANEL}.dpkg-divert-aims"; echo 'NoDisplay=true'; } > "$UPANEL"; fixed+=("panneau-utilisateurs")
fi
# 4b. Packet Tracer : lanceur non interactif (sinon boucle de licence, voir
# /usr/lib/aims-os/packettracer-fix)
if [ -x /opt/pt/packettracer.AppImage ]; then
    pt_prod=$(grep -h -m1 '^Icon=' /usr/share/applications/CiscoPacketTracer-*.desktop 2>/dev/null | cut -d= -f2)
    if ! grep -q '^Exec=env DEBIAN_FRONTEND=noninteractive' /usr/share/applications/CiscoPacketTracer-*.desktop 2>/dev/null \
       || { [ -n "$pt_prod" ] && [ ! -f "/etc/skel/.local/.packettracer/eula-$pt_prod" ]; }; then
        /usr/lib/aims-os/packettracer-fix; fixed+=("packettracer-licence")
    fi
fi
# 5. Bilan
last_sudo="$(journalctl _COMM=sudo --since -1h --no-pager -o cat 2>/dev/null | grep -E "COMMAND=" | tail -1 | sed -E 's/^ *//' | cut -c1-200)"
if [ ${#fixed[@]} -gt 0 ]; then
    note "REPARE: ${fixed[*]} | dernier sudo: ${last_sudo:-aucun}"
else
    logger -t aims-labo-ensure -p local5.info -- "ok"
fi
exit 0
