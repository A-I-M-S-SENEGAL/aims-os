#!/bin/bash
# aims-labo-grub-password — set the GRUB superuser password on this machine.
#   aims-labo-grub-password            generate a random password, print it ONCE
#   aims-labo-grub-password --stdin    read the password from stdin
# Writes /etc/aims-os/grub-password.pbkdf2 and regenerates grub.cfg.
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "root required" >&2; exit 1; }
if [ "${1:-}" = "--stdin" ]; then
    read -r pw
else
    pw="$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 20)"
fi
[ ${#pw} -ge 12 ] || { echo "password too short (12+)" >&2; exit 1; }
hash="$(printf '%s\n%s\n' "$pw" "$pw" | grub-mkpasswd-pbkdf2 | sed -n 's/.*is //p')"
[ -n "$hash" ] || { echo "grub-mkpasswd-pbkdf2 failed" >&2; exit 1; }
install -d -m 0755 /etc/aims-os
printf '%s\n' "$hash" > /etc/aims-os/grub-password.pbkdf2
chmod 0600 /etc/aims-os/grub-password.pbkdf2
update-grub >/dev/null 2>&1 || update-grub
if [ "${1:-}" != "--stdin" ]; then
    echo "GRUB superuser: aimsit"
    echo "GRUB password : ${pw}"
    echo "(store it in the team password manager now; it is not kept anywhere else)"
fi
