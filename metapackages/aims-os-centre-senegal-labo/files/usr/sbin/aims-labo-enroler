#!/bin/bash
# aims-labo-enroler — donne son identité à un poste cloné et l'enrôle dans l'annuaire.
#   sudo aims-labo-enroler 07        → le poste devient labo-hp-07.lab.aimssnportal.org
# Demande le mot de passe du compte « enrol » (1Password, rôle limité à
# l'enregistrement des postes). Marche en Wi-Fi comme en filaire.
# Régénère ce qu'un clone ne doit pas partager : machine-id, clés SSH.
set -euo pipefail
DOMAIN=lab.aimssnportal.org; REALM=LAB.AIMSSNPORTAL.ORG; SERVER=ipa.lab.aimssnportal.org; PREFIX=labo-hp
[ "$(id -u)" -eq 0 ] || { echo "sudo requis" >&2; exit 1; }
[ $# -eq 1 ] && [[ "$1" =~ ^[0-9]{1,3}$ ]] || { echo "usage : sudo aims-labo-enroler <numéro du poste, ex. 07>" >&2; exit 1; }
n=$(printf '%02d' "$((10#$1))"); host="${PREFIX}-${n}"; fqdn="${host}.${DOMAIN}"
echo "Ce poste va devenir : ${fqdn}"
read -r -s -p "Mot de passe du compte enrol : " pw; echo
[ -n "$pw" ] || { echo "mot de passe vide" >&2; exit 1; }
# 1. identité unique du clone
rm -f /etc/machine-id /var/lib/dbus/machine-id; systemd-machine-id-setup >/dev/null 2>&1; ln -sf /etc/machine-id /var/lib/dbus/machine-id
rm -f /etc/ssh/ssh_host_*; dpkg-reconfigure -f noninteractive openssh-server >/dev/null 2>&1
# 2. ancien enrôlement (poste modèle capturé enrôlé, ou ré-enrôlement)
if [ -f /etc/ipa/default.conf ]; then ipa-client-install --uninstall -U >/dev/null 2>&1 || true; fi
# 3. nom
hostnamectl set-hostname "$fqdn"; sed -i "s/^127\.0\.1\.1.*/127.0.1.1 ${fqdn} ${host}/" /etc/hosts; grep -q "^127.0.1.1" /etc/hosts || echo "127.0.1.1 ${fqdn} ${host}" >> /etc/hosts
systemctl restart systemd-resolved >/dev/null 2>&1 || true
# 4. enrôlement (le compte enrol crée la fiche du poste s'il n'existe pas)
if ipa-client-install --unattended --domain "$DOMAIN" --realm "$REALM" --server "$SERVER" --hostname "$fqdn" \
     --principal enrol --password "$pw" --mkhomedir --enable-dns-updates --no-ntp --force-join >/tmp/aims-enrol.log 2>&1; then
    systemctl restart sssd >/dev/null 2>&1 || true
    /usr/sbin/aims-labo-ensure >/dev/null 2>&1 || true
    echo "OK : ${fqdn} est enrôlé. Attribuer un étudiant depuis le serveur : aims-labo attribuer <login> ${host}"
    echo "(un étudiant ne peut ouvrir de session ici qu'après attribution)"
else
    echo "ECHEC de l'enrôlement, détails : /tmp/aims-enrol.log" >&2; tail -5 /tmp/aims-enrol.log >&2; exit 1
fi
