#!/bin/bash
# aims-db — bases de données personnelles, sans droits root (Podman rootless).
#   aims-db start postgres|mariadb|redis|mongo   démarre votre serveur
#   aims-db stop  <nom>                           l'arrête (les données restent)
#   aims-db status                                ce qui tourne
#   aims-db reset <nom>                           efface les données
# Chaque étudiant a ses propres serveurs et ses propres données (~/.local/share/aims-db).
set -euo pipefail
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/aims-db"; mkdir -p "$DATA"
PW="${AIMS_DB_PASSWORD:-aims}"
usage() { sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
spec() {
    case "$1" in
        postgres) echo "docker.io/library/postgres:17 5432:5432 /var/lib/postgresql/data -e POSTGRES_PASSWORD=$PW -e POSTGRES_USER=aims -e POSTGRES_DB=aims" ;;
        mariadb)  echo "docker.io/library/mariadb:11 3306:3306 /var/lib/mysql -e MARIADB_ROOT_PASSWORD=$PW -e MARIADB_USER=aims -e MARIADB_PASSWORD=$PW -e MARIADB_DATABASE=aims" ;;
        redis)    echo "docker.io/library/redis:7 6379:6379 /data" ;;
        mongo)    echo "docker.io/library/mongo:8 27017:27017 /data/db -e MONGO_INITDB_ROOT_USERNAME=aims -e MONGO_INITDB_ROOT_PASSWORD=$PW" ;;
        *) echo "aims-db: base inconnue '$1' (postgres, mariadb, redis, mongo)" >&2; exit 1 ;;
    esac
}
case "${1:-}" in
    start)
        [ $# -eq 2 ] || usage; read -r image port vol envs <<<"$(spec "$2")"
        mkdir -p "$DATA/$2"
        if podman container exists "aims-$2" 2>/dev/null; then podman start "aims-$2" >/dev/null; else
            # shellcheck disable=SC2086
            podman run -d --name "aims-$2" -p "127.0.0.1:$port" -v "$DATA/$2:$vol:Z" $envs "$image" >/dev/null
        fi
        echo "$2 démarré sur localhost:${port%%:*}  (utilisateur aims, mot de passe $PW ; redis sans mot de passe)" ;;
    stop)   [ $# -eq 2 ] || usage; podman stop "aims-$2" >/dev/null && echo "$2 arrêté" ;;
    status) podman ps --filter name=aims- --format "{{.Names}}  {{.Status}}  {{.Ports}}" | sed 's/^aims-//' ;;
    reset)  [ $# -eq 2 ] || usage; podman rm -f "aims-$2" >/dev/null 2>&1 || true; rm -rf "${DATA:?}/$2"; echo "$2 : données effacées" ;;
    *) usage ;;
esac
