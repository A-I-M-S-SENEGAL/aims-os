# AIMS OS — lab workstation defaults (aims-os-centre-senegal-labo).
# Fixed machines in the Mbour lab: never suspend (they must stay
# reachable for SSH and FOG), blank the screen after 15 minutes instead.
# Not locked; compiled by `dconf update` in the package postinst.
[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-type='nothing'
sleep-inactive-ac-timeout=0
sleep-inactive-battery-type='nothing'
power-button-action='interactive'

[org/gnome/desktop/session]
idle-delay=uint32 900

# Ctrl+Alt+T ouvre le Terminal, comme sous Ubuntu : GNOME sous Debian ne le
# définit pas (demande de Hakim, 5 octobre 2026). La touche T est au même
# endroit en AZERTY et en QWERTY, le raccourci vaut donc sur tous les postes ;
# il ne touche pas aux dispositions de clavier propres à chaque poste.
[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/aims-terminal/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/aims-terminal]
name='Terminal'
command='gnome-terminal'
binding='<Primary><Alt>t'

# Alt+Maj ne change plus de clavier. L'image (00-aims-os) active l'option
# grp:alt_shift_toggle : des étudiants passaient en AZERTY sans le voir, et
# l'écran de verrouillage, qui garde le clavier de la session, refusait alors
# leur mot de passe (labo-dell-03, 5 octobre 2026). Touche Windows + Espace et
# le menu du clavier en haut à droite changent toujours de clavier.
# mru-sources vide et verrouillé (locks/02-aims-labo) : GNOME ne reprend plus
# le dernier clavier utilisé, chaque session s'ouvre sur le premier clavier du
# poste (US sur les Dell et les postes en anglais, AZERTY ailleurs).
[org/gnome/desktop/input-sources]
xkb-options=@as []
mru-sources=@a(ss) []

# Clavier visuel à un clic : l'icône d'accessibilité reste dans la barre du
# haut, et son menu affiche ou masque le clavier visuel. Les étudiants qui ne
# connaissent pas l'AZERTY y trouvent < > | { } [ ] (demande de Hakim,
# 7 octobre 2026). Pas screen-keyboard-enabled : GNOME ferait surgir le
# clavier à chaque champ de texte, même avec le vrai clavier.
[org/gnome/desktop/a11y]
always-show-universal-access-status=true
