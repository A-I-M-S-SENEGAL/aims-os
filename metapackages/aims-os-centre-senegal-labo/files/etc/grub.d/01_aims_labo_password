#!/bin/sh
# AIMS OS labo — GRUB superuser (aims-os-centre-senegal-labo).
# Without this, anyone at the keyboard presses `e` at boot, adds
# init=/bin/bash and is root. The PBKDF2 hash lives in
# /etc/aims-os/grub-password.pbkdf2 (root 0600), written on the golden
# machine by `aims-labo-grub-password`; the clear password goes to the
# team's password manager. Normal boot entries stay unrestricted (see
# the patched 10_linux, CLASS += --unrestricted): only editing entries
# or the GRUB console asks for the password.
set -e
f=/etc/aims-os/grub-password.pbkdf2
[ -s "$f" ] || exit 0
hash=$(head -n1 "$f")
cat <<GRUB
set superusers="aimsit"
export superusers
password_pbkdf2 aimsit ${hash}
GRUB
