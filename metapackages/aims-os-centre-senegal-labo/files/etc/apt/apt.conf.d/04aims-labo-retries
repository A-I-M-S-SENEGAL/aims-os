// Le lien du campus perd une connexion sur six, et le cache apt du serveur
// répond alors 503. Sans ces réglages, une installation de plusieurs
// centaines de paquets s'arrête sur le premier fichier manqué.
Acquire::Retries "6";
Acquire::http::Timeout "40";
Acquire::https::Timeout "40";

// Un étudiant peut lancer apt au même moment que la réparation horaire ou
// l'installateur : attendre le verrou plutôt que d'échouer.
DPkg::Lock::Timeout "300";
