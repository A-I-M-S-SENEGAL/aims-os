#!/bin/sh
set -e

case "$1" in
    configure)
        # IT admin account: no password (key-only SSH), bash, sudo via
        # /etc/sudoers.d/aims-labo-it. aims-firstboot adds it to docker
        # and wireshark like any other UID >= 1000 account.
        if ! getent passwd aimsit >/dev/null; then
            adduser --quiet --disabled-password --gecos "AIMS IT" \
                --shell /bin/bash aimsit
        fi

        # The sshd drop-in gates logins on AllowGroups: the local IT account
        # belongs to aims-ssh, the IT staff to the directory group admins.
        getent group aims-ssh >/dev/null || addgroup --quiet --system aims-ssh
        id -nG aimsit 2>/dev/null | grep -qw aims-ssh || \
            adduser --quiet aimsit aims-ssh

        # Keep it out of the GDM login list: it has no password anyway.
        mkdir -p -m 0700 /var/lib/AccountsService/users
        if [ ! -f /var/lib/AccountsService/users/aimsit ]; then
            printf '[User]\nSystemAccount=true\n' \
                > /var/lib/AccountsService/users/aimsit
        fi

        # aims-os-core enables UFW with deny-in (hook 0030-ufw-defaults),
        # so sshd is unreachable until a rule opens it. Campus LAN only:
        # off site the IT team hops through server 2 anyway.
        # limit, not allow: passwords are accepted for the IT group since
        # 8 September 2026, so repeated attempts from one address are dropped.
        if command -v ufw >/dev/null 2>&1; then
            ufw limit from 192.168.10.0/24 to any port 22 proto tcp \
                comment "AIMS IT SSH (aims-os-centre-senegal-labo)" \
                >/dev/null 2>&1 || true
        fi

        # Lab workstations must stay reachable: never suspend. The dconf
        # default (02-aims-labo) stops GNOME's idle suspend; the /dev/null
        # symlinks in debian/links mask the systemd sleep targets for
        # every other path (menu, lid, DE bugs).
        if command -v dconf >/dev/null 2>&1; then
            dconf update 2>/dev/null || true
        fi

        # Kerberos (FreeIPA) needs clocks within five minutes; installed
        # systems came up with systemd-timesyncd disabled.
        if [ -d /run/systemd/system ]; then
            deb-systemd-helper enable systemd-timesyncd.service >/dev/null 2>&1 || true
            deb-systemd-invoke start systemd-timesyncd.service >/dev/null 2>&1 || true
        fi

        # GRUB: normal entries must boot without a password once a superuser
        # is set, so Debian's 10_linux gets --unrestricted in CLASS. Done
        # through a diversion so grub upgrades land at the diverted name.
        # The diverted name must match grub-mkconfig's ignore list
        # (*.dpkg-*): with any other name the original script runs too
        # and every entry shows twice (seen on labo-hp-01, 2026-09-07).
        # Settings > Users cannot change a directory password and misleads
        # students (9 September 2026): hide its entry from application
        # search, so "mot de passe" finds only "Changer mon mot de passe".
        # The panel stays reachable inside Settings. Diversion, so that
        # gnome-control-center upgrades land at the diverted name.
        UPANEL=/usr/share/applications/gnome-users-panel.desktop
        UDIV="${UPANEL}.dpkg-divert-aims"
        if [ -f "${UPANEL}" ] || [ -f "${UDIV}" ]; then
            if ! dpkg-divert --list "${UPANEL}" 2>/dev/null | grep -q "${UDIV}"; then
                dpkg-divert --quiet --add --rename --package aims-os-centre-senegal-labo \
                    --divert "${UDIV}" "${UPANEL}"
            fi
            if [ -f "${UDIV}" ]; then
                { grep -v '^NoDisplay=' "${UDIV}"; echo 'NoDisplay=true'; } > "${UPANEL}"
                chmod 0644 "${UPANEL}"
            fi
        fi

        DIV=/etc/grub.d/10_linux.dpkg-divert-aims
        if [ -f /etc/grub.d/10_linux.aims-original ]; then
            # migrate the 2.1+4..2.1+7 diversion
            rm -f /etc/grub.d/10_linux
            dpkg-divert --quiet --remove --rename --package aims-os-centre-senegal-labo /etc/grub.d/10_linux || true
        fi
        if [ -f /etc/grub.d/10_linux ] || [ -f "${DIV}" ]; then
            if ! dpkg-divert --list /etc/grub.d/10_linux | grep -q "${DIV}"; then
                dpkg-divert --quiet --add --rename --package aims-os-centre-senegal-labo \
                    --divert "${DIV}" /etc/grub.d/10_linux
            fi
            sed 's/^CLASS="--class gnu-linux/CLASS="--unrestricted --class gnu-linux/' \
                "${DIV}" > /etc/grub.d/10_linux
            chmod 0755 /etc/grub.d/10_linux
            if [ -s /etc/aims-os/grub-password.pbkdf2 ] && command -v update-grub >/dev/null 2>&1; then
                update-grub >/dev/null 2>&1 || true
            fi
        fi

        # The local account created by the installer (member of sudo, same
        # password on every clone) must not remain a root path on lab
        # machines: lock it and drop it from sudo. IT uses aimsit (key) and
        # the directory group admins (sudo rule in FreeIPA).
        for u in $(getent group sudo | cut -d: -f4 | tr ',' ' '); do
            [ "${u}" = "aimsit" ] && continue
            uid=$(id -u "${u}" 2>/dev/null || echo 0)
            [ "${uid}" -ge 1000 ] || continue
            passwd -l "${u}" >/dev/null 2>&1 && echo "aims-os-centre-senegal-labo: local account ${u} locked" || true
            gpasswd -d "${u}" sudo >/dev/null 2>&1 || true
        done

        # Faster login screen: no nouveau in the initramfs (see
        # /etc/modprobe.d/aims-labo-nouveau.conf) and Docker started on
        # demand by its socket instead of at every boot (IT-only tool).
        if [ -d /run/systemd/system ]; then
            deb-systemd-helper disable docker.service >/dev/null 2>&1 || true
            deb-systemd-helper enable docker.socket >/dev/null 2>&1 || true
        fi
        if command -v update-initramfs >/dev/null 2>&1 && [ ! -f /var/lib/aims-os/labo-nouveau-initramfs ]; then
            update-initramfs -u >/dev/null 2>&1 && mkdir -p /var/lib/aims-os && touch /var/lib/aims-os/labo-nouveau-initramfs || true
        fi

        # IPv4-only campus: apply the sysctl now, not only at next boot.
        sysctl -q -p /etc/sysctl.d/60-aims-labo-ipv6.conf >/dev/null 2>&1 || true

        # Hourly self-repair + live log copy to the campus server.
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
            deb-systemd-helper enable aims-labo-ensure.timer >/dev/null 2>&1 || true
            deb-systemd-helper enable aims-labo-update.timer >/dev/null 2>&1 || true
            deb-systemd-invoke start aims-labo-update.timer >/dev/null 2>&1 || true
            deb-systemd-invoke start aims-labo-ensure.timer >/dev/null 2>&1 || true
            deb-systemd-invoke restart rsyslog.service >/dev/null 2>&1 || true
        fi

        # EFI fallback loader: a clone has no NVRAM entry, the firmware runs
        # \EFI\BOOT\BOOTX64.EFI, which reads grub.cfg from its own folder.
        # The installer leaves that file under \EFI\<id>\ only, so a clone
        # dropped to "grub>" (9 September 2026). Keep a copy next to it.
        if [ -d /boot/efi/EFI/BOOT ]; then
            src=$(ls /boot/efi/EFI/*/grub.cfg 2>/dev/null | grep -viE "/EFI/BOOT/" | head -1)
            if [ -n "$src" ]; then
                d=$(dirname "$src")
                # full signed chain: shim (Microsoft-signed, Secure Boot ok)
                # as the fallback loader, then grub, MokManager, the stub.
                [ -f "$d/shimx64.efi" ] && cp -f "$d/shimx64.efi" /boot/efi/EFI/BOOT/BOOTX64.EFI || true
                [ -f "$d/grubx64.efi" ] && cp -f "$d/grubx64.efi" /boot/efi/EFI/BOOT/grubx64.efi || true
                [ -f "$d/mmx64.efi" ] && cp -f "$d/mmx64.efi" /boot/efi/EFI/BOOT/mmx64.efi || true
                cp -f "$src" /boot/efi/EFI/BOOT/grub.cfg || true
            fi
        fi

        # aimsit never authenticates with a password, even if a student with
        # sudo sets one locally. A Match block must end the main file: inside
        # a drop-in it would swallow the rest of sshd_config.
        if ! grep -q "^Match User aimsit" /etc/ssh/sshd_config; then
            printf '\n# aims-os-centre-senegal-labo : le compte IT local entre par clé seulement\nMatch User aimsit\n    PasswordAuthentication no\n    KbdInteractiveAuthentication no\n' >> /etc/ssh/sshd_config
        fi

        # Apply the sshd drop-in on a running system. deb-systemd-invoke
        # honours policy-rc.d, so this is a no-op inside a build chroot.
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke reload ssh.service >/dev/null 2>&1 || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
