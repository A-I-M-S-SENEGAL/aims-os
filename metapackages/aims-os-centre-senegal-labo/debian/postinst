#!/bin/sh
set -e

case "$1" in
    configure)
        # IT admin account: no password (key-only SSH), bash, sudo via
        # /etc/sudoers.d/aims-labo-it. aims-firstboot adds it to docker
        # and wireshark like any other UID >= 1000 account.
        if ! getent passwd aimsit >/dev/null; then
            adduser --quiet --disabled-password --gecos "AIMS IT" \
                --shell /bin/bash aimsit
        fi

        # Keep it out of the GDM login list: it has no password anyway.
        mkdir -p -m 0700 /var/lib/AccountsService/users
        if [ ! -f /var/lib/AccountsService/users/aimsit ]; then
            printf '[User]\nSystemAccount=true\n' \
                > /var/lib/AccountsService/users/aimsit
        fi

        # aims-os-core enables UFW with deny-in (hook 0030-ufw-defaults),
        # so sshd is unreachable until a rule opens it. Campus LAN only:
        # off site the IT team hops through server 2 anyway.
        if command -v ufw >/dev/null 2>&1; then
            ufw allow from 192.168.10.0/24 to any port 22 proto tcp \
                comment "AIMS IT SSH (aims-os-centre-senegal-labo)" \
                >/dev/null 2>&1 || true
        fi

        # Lab workstations must stay reachable: never suspend. The dconf
        # default below stops GNOME's idle suspend; masking the systemd
        # targets stops every other path (menu, lid, DE bugs).
        if command -v dconf >/dev/null 2>&1; then
            dconf update 2>/dev/null || true
        fi
        if [ -d /run/systemd/system ]; then
            systemctl mask sleep.target suspend.target hibernate.target \
                hybrid-sleep.target >/dev/null 2>&1 || true
        fi

        # Apply the sshd drop-in on a running system. deb-systemd-invoke
        # honours policy-rc.d, so this is a no-op inside a build chroot.
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke reload ssh.service >/dev/null 2>&1 || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
