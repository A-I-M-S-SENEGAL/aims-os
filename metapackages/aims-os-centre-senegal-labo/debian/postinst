#!/bin/sh
set -e

case "$1" in
    configure)
        # IT admin account: no password (key-only SSH), bash, sudo via
        # /etc/sudoers.d/aims-labo-it. aims-firstboot adds it to docker
        # and wireshark like any other UID >= 1000 account.
        if ! getent passwd aimsit >/dev/null; then
            adduser --quiet --disabled-password --gecos "AIMS IT" \
                --shell /bin/bash aimsit
        fi

        # Keep it out of the GDM login list: it has no password anyway.
        mkdir -p -m 0700 /var/lib/AccountsService/users
        if [ ! -f /var/lib/AccountsService/users/aimsit ]; then
            printf '[User]\nSystemAccount=true\n' \
                > /var/lib/AccountsService/users/aimsit
        fi

        # aims-os-core enables UFW with deny-in (hook 0030-ufw-defaults),
        # so sshd is unreachable until a rule opens it. Campus LAN only:
        # off site the IT team hops through server 2 anyway.
        if command -v ufw >/dev/null 2>&1; then
            ufw allow from 192.168.10.0/24 to any port 22 proto tcp \
                comment "AIMS IT SSH (aims-os-centre-senegal-labo)" \
                >/dev/null 2>&1 || true
        fi

        # Lab workstations must stay reachable: never suspend. The dconf
        # default (02-aims-labo) stops GNOME's idle suspend; the /dev/null
        # symlinks in debian/links mask the systemd sleep targets for
        # every other path (menu, lid, DE bugs).
        if command -v dconf >/dev/null 2>&1; then
            dconf update 2>/dev/null || true
        fi

        # Kerberos (FreeIPA) needs clocks within five minutes; installed
        # systems came up with systemd-timesyncd disabled.
        if [ -d /run/systemd/system ]; then
            deb-systemd-helper enable systemd-timesyncd.service >/dev/null 2>&1 || true
            deb-systemd-invoke start systemd-timesyncd.service >/dev/null 2>&1 || true
        fi

        # GRUB: normal entries must boot without a password once a superuser
        # is set, so Debian's 10_linux gets --unrestricted in CLASS. Done
        # through a diversion so grub upgrades land at the diverted name.
        if [ -f /etc/grub.d/10_linux ]; then
            if ! dpkg-divert --list /etc/grub.d/10_linux | grep -q aims; then
                dpkg-divert --quiet --add --rename --package aims-os-centre-senegal-labo \
                    --divert /etc/grub.d/10_linux.aims-original /etc/grub.d/10_linux
            fi
            sed 's/^CLASS="--class gnu-linux/CLASS="--unrestricted --class gnu-linux/' \
                /etc/grub.d/10_linux.aims-original > /etc/grub.d/10_linux
            chmod 0755 /etc/grub.d/10_linux
            if [ -s /etc/aims-os/grub-password.pbkdf2 ] && command -v update-grub >/dev/null 2>&1; then
                update-grub >/dev/null 2>&1 || true
            fi
        fi

        # The local account created by the installer (member of sudo, same
        # password on every clone) must not remain a root path on lab
        # machines: lock it and drop it from sudo. IT uses aimsit (key) and
        # the directory group admins (sudo rule in FreeIPA).
        for u in $(getent group sudo | cut -d: -f4 | tr ',' ' '); do
            [ "${u}" = "aimsit" ] && continue
            uid=$(id -u "${u}" 2>/dev/null || echo 0)
            [ "${uid}" -ge 1000 ] || continue
            passwd -l "${u}" >/dev/null 2>&1 && echo "aims-os-centre-senegal-labo: local account ${u} locked" || true
            gpasswd -d "${u}" sudo >/dev/null 2>&1 || true
        done

        # Apply the sshd drop-in on a running system. deb-systemd-invoke
        # honours policy-rc.d, so this is a no-op inside a build chroot.
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke reload ssh.service >/dev/null 2>&1 || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
