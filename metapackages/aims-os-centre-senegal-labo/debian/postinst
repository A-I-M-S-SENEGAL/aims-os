#!/bin/sh
set -e

case "$1" in
    configure)
        # IT admin account: no password (key-only SSH), bash, sudo via
        # /etc/sudoers.d/aims-labo-it. aims-firstboot adds it to docker
        # and wireshark like any other UID >= 1000 account.
        if ! getent passwd aimsit >/dev/null; then
            adduser --quiet --disabled-password --gecos "AIMS IT" \
                --shell /bin/bash aimsit
        fi

        # Keep it out of the GDM login list: it has no password anyway.
        mkdir -p -m 0700 /var/lib/AccountsService/users
        if [ ! -f /var/lib/AccountsService/users/aimsit ]; then
            printf '[User]\nSystemAccount=true\n' \
                > /var/lib/AccountsService/users/aimsit
        fi

        # Apply the sshd drop-in on a running system. deb-systemd-invoke
        # honours policy-rc.d, so this is a no-op inside a build chroot.
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke reload ssh.service >/dev/null 2>&1 || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
