# --- GNOME desktop ----------------------------------------------------
 task-gnome-desktop,
 gnome-tweaks,
 gnome-shell-extensions,
 gnome-shell-extension-manager,
 dconf-cli,
 dconf-editor,
# --- Calamares graphical installer: NOT here ------------------------
# calamares / calamares-settings-debian / qml6-module-qtquick-controls
# live in build/config/package-lists/40-installer.list.chroot. Calamares
# removes calamares-settings-debian from the target at the end of every
# install; while it was a Depends here, that purge took aims-os-desktop
# with it (seen on labo-hp-01, 2026-09-03), leaving installed machines
# without the desktop metapackage and its updates.
# --- Boot splash (themed by aims-os-branding) ------------------------
 plymouth,
 plymouth-themes,
 plymouth-label,
# --- Bootloader payload for Calamares installs -----------------------
# calamares-settings-debian installs grub-pc / grub-efi into the target
# from the ISO's package pool at install time. When that step fails the
# target is left without a bootloader (seen on 2026-09-03 on an HP
# All-in-One; Debian bug #1005196 describes the same failure for offline
# installs). Ship the GRUB binaries in the live system so
# `grub-install` always works, BIOS or UEFI, media or not.
# grub-pc-bin and grub-efi-amd64-bin coexist; only the grub-pc /
# grub-efi-amd64 config packages conflict, so those stay out.
# This metapackage is Architecture: all, so per-architecture packages
# are expressed as alternatives: apt takes the first installable one,
# i.e. the amd64 binaries on amd64 and grub-efi-arm64-* on arm64
# (arm64 machines are UEFI-only, there is no grub-pc there).
 grub2-common,
 grub-pc-bin | grub-efi-arm64-bin,
 grub-efi-amd64-bin | grub-efi-arm64-bin,
 grub-efi-amd64-signed | grub-efi-arm64-signed,
 shim-signed,
 efibootmgr,
# --- One browser (French) --------------------------------------------
# Chromium + Chromium-l10n moved to aims-os-desktop-extras. Firefox ESR
# is sufficient for the live install + first-boot wizard.
 firefox-esr,
 firefox-esr-l10n-fr,
# --- Office: LibreOffice + French dictionary -------------------------
# libreoffice-help-fr, libreoffice-l10n-en-gb, English hunspell/hyphen/
