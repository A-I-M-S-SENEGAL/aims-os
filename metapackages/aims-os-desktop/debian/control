 libreoffice,
 libreoffice-l10n-fr,
 hunspell-fr,
 hyphen-fr,
 mythes-fr,
# --- Fonts ------------------------------------------------------------
 fonts-liberation,
 fonts-noto,
 fonts-noto-cjk,
 fonts-noto-color-emoji,
 fonts-firacode,
# --- Documents, image viewing, media playback ------------------------
# GIMP + Inkscape + Shotwell + Evolution + ghostwriter + flameshot
# moved to aims-os-desktop-extras (creative / niche tools).
 evince,
 gnome-text-editor,
