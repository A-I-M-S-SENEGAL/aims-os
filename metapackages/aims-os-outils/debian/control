Depends: ${misc:Depends},
 aims-os-everything,
# The Debian packages the lab profile adds on top of every layer.
 vlc, scilab, qgis, flatpak, gnome-software-plugin-flatpak,
 qemu-system-x86, qemu-utils, libvirt-daemon-system, libvirt-clients,
